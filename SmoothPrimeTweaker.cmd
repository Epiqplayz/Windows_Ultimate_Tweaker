:: ==============================================================================
:: MODULE [91]: UNIVERSAL PCIE MSI-X / IRQ AFFINITY & HIGH-PRIORITY POLICY ENGINE
:: ==============================================================================
:deep_pcie_msi_irq_affinity_engine
cls
echo.
echo   %b%+==============================================================================================================+%w%
echo   %b%^|%w%          %p%SMOOTH PRIME v7x  -  UNIVERSAL PCIE MSI-X ^& IRQ INTERRUPT AFFINITY POLICY ENGINE%w%                  %b%^|%w%
echo   %b%^|%w%            %g%ENGINEERED BY SMOOTH PRIME  ^|  CPU: !CPU_TOPOLOGY_STR!  ^|  GPU: !DETECTED_GPU_NAME!%w%
echo   %b%+==============================================================================================================+%w%
echo.
echo   %b%+--- %p%SELECT PCIE MSI-X ^& IRQ INTERRUPT ACTION%b% -------------------------------------------------------------+%w%
echo   %b%^|%w%  %p%[%w%1%p%]%w%  Enable MSI Mode + High Interrupt Priority [DevicePriority=3] on All Display, USB xHCI ^& NVMe Buses   %b%^|%w%
echo   %b%^|%w%  %p%[%w%2%p%]%w%  Spread Multi-Queue Interrupts Across All Cores [IrqPolicySpreadMessagesAcrossAllProcessors]            %b%^|%w%
echo   %b%^|%w%  %p%[%w%3%p%]%w%  Reset All PCIe Interrupt Affinity Policies to Windows Default [Safe Rollback]                          %b%^|%w%
echo   %b%+--------------------------------------------------------------------------------------------------------------+%w%
echo    %p%[%w%M%p%]%w% Back to Smooth Prime v7x Main Dashboard
echo.
set "msi_opt="
set /p "msi_opt=  %p%[SmoothPrime v7x]%w% Select Option: "
if /i "%msi_opt%"=="1" goto msi_high_prio_apply
if /i "%msi_opt%"=="2" goto msi_spread_apply
if /i "%msi_opt%"=="3" goto msi_reset_def
if /i "%msi_opt%"=="M" goto menu
goto deep_pcie_msi_irq_affinity_engine

:msi_high_prio_apply
echo.
echo   %w%[*] Scanning All PCIe Devices Supporting MSI ^& Locking MSISupported=1 + High DevicePriority...%b%
call :RunEngine TargetedPcieMsi
for /f "tokens=*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /s /f "Interrupt Management" /k 2^>nul ^| findstr /i "Interrupt Management$"') do (
    reg add "%%A\Affinity Policy" /v "DevicePriority" /t REG_DWORD /d "3" /f >nul 2>&1
)
echo   %p%[+] PCIe MSI Mode [MSISupported=1] ^& High Interrupt Priority [DevicePriority=3] Applied!%w%
call :SmoothPrimePause
goto deep_pcie_msi_irq_affinity_engine

:msi_spread_apply
echo.
echo   %w%[*] Configuring IrqPolicySpreadMessagesAcrossAllProcessors [DevicePolicy=4] Across PCIe Controllers...%b%
for /f "tokens=*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /s /f "Interrupt Management" /k 2^>nul ^| findstr /i "Interrupt Management$"') do (
    reg add "%%A\Affinity Policy" /v "DevicePolicy" /t REG_DWORD /d "4" /f >nul 2>&1
)
echo   %p%[+] Multi-Queue PCIe Interrupts Spread Across All Unparked CPU Cores [Zero Core 0 Bottleneck]!%w%
call :SmoothPrimePause
goto deep_pcie_msi_irq_affinity_engine

:msi_reset_def
echo.
echo   %w%[*] Resetting PCIe Interrupt Affinity Policy Keys to Windows Default...%b%
for /f "tokens=*" %%A in ('reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /s /f "Affinity Policy" /k 2^>nul ^| findstr /i "Affinity Policy$"') do (
    reg delete "%%A" /v "DevicePolicy" /f >nul 2>&1
    reg delete "%%A" /v "DevicePriority" /f >nul 2>&1
    reg delete "%%A" /v "AssignmentSetOverride" /f >nul 2>&1
)
echo   %p%[+] PCIe Interrupt Affinity Policies Reset to OS Default.%w%
call :SmoothPrimePause
goto deep_pcie_msi_irq_affinity_engine


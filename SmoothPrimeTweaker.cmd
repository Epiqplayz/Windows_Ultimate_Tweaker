:: ==============================================================================
:: MODULE [111 / FIX]: EMERGENCY SYSTEM, BOOT, DISPLAY, INSTALLER & CRASH HEALER
:: Repairs systems damaged by aggressive tweaks (Fixes Boot, Display, Installers, Crashes)
:: ==============================================================================
:system_stability_installer_healer
cls
echo.
echo   %b%+==============================================================================================================+%w%
echo   %b%^|%w%       %p%SMOOTH PRIME v7x  -  EMERGENCY BOOT, DISPLAY, INSTALLER ^& STABILITY REPAIR ENGINE [111 / FIX]%w%         %b%^|%w%
echo   %b%^|%w%            %g%ENGINEERED BY SMOOTH PRIME  ^|  Restores Win11 24H2/26H2 Boot, Display, Installers ^& .NET%w%        %b%^|%w%
echo   %b%+==============================================================================================================+%w%
echo.
echo   %b%+--- %p%SELECT SYSTEM STABILITY, BOOT, DISPLAY ^& INSTALLER REPAIR ACTION%b% -------------------------------------+%w%
echo   %b%^|%w%  %p%[%w%1%p%]%w%  %p%RUN COMPLETE 20-POINT BOOT, DISPLAY, INSTALLER, .NET ^& CRASH HEALER [Recommended Fix]%w%                 %b%^|%w%
echo   %b%^|%w%  %p%[%w%2%p%]%w%  Fix Application Installers ^& .NET Only [AutoRun, ConsentUx/Ncb/VaultSvc, AppCompat, PcaSvc ^& NGEN]   %b%^|%w%
echo   %b%^|%w%  %p%[%w%3%p%]%w%  Fix Boot Loops ^& Display Output Init Only [Fix DMA Remap, UEFI GOP BCD, Display Class ^& Autologgers] %b%^|%w%
echo   %b%^|%w%  %p%[%w%4%p%]%w%  Fix Windows Freezes, Crashes ^& Glitches Only [Fix PagedPool, WDDM Preemption, EventLog ^& SystemApps]  %b%^|%w%
echo   %b%+--------------------------------------------------------------------------------------------------------------+%w%
echo    %p%[%w%M%p%]%w% Back to Smooth Prime v7x Main Dashboard
echo.
set "fix_opt="
set /p "fix_opt=  %p%[SmoothPrime v7x]%w% Select Option: "
if /i "%fix_opt%"=="1" goto healer_run_all
if /i "%fix_opt%"=="2" goto healer_installers_only
if /i "%fix_opt%"=="3" goto healer_crashes_only
if /i "%fix_opt%"=="4" goto healer_freezes_only
if /i "%fix_opt%"=="M" goto menu
goto system_stability_installer_healer

:healer_run_all
call :ExecuteStabilityHealer
call :RestoreStartAndSearchSub
call :SmoothPrimePause
goto system_stability_installer_healer

:healer_installers_only
call :Healer_FixInstallers
call :SmoothPrimePause
goto system_stability_installer_healer

:healer_crashes_only
call :Healer_FixCrashes
call :SmoothPrimePause
goto system_stability_installer_healer

:healer_freezes_only
call :Healer_FixFreezes
call :RestoreStartAndSearchSub
call :SmoothPrimePause
goto system_stability_installer_healer

:ExecuteStabilityHealer
echo.
echo   %w%[*] Executing Smooth Prime v7x 20-Point Boot, Display, Installer, .NET ^& Stability Healer...%b%
call :Healer_FixInstallers
call :Healer_FixCrashes
call :Healer_FixFreezes
call :RunEngine RepairSystemStability
echo   %p%[+] Complete 20-Point Boot, Display, Installer, .NET ^& Stability Repair Finished Successfully!%w%
exit /b 0

:Healer_FixInstallers
echo   %w%[*] [Healer 1/3] Restoring Application Installers, Command Processor, UAC Services, AppCompat ^& .NET...%b%
:: 1. Purge Command Processor AutoRun hooks so cmd.exe /c batch & silent installer pipelines never break
reg delete "HKLM\SOFTWARE\Microsoft\Command Processor" /v "AutoRun" /f >nul 2>&1
reg delete "HKCU\SOFTWARE\Microsoft\Command Processor" /v "AutoRun" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\WOW6432Node\Microsoft\Command Processor" /v "AutoRun" /f >nul 2>&1
reg delete "HKCU\SOFTWARE\WOW6432Node\Microsoft\Command Processor" /v "AutoRun" /f >nul 2>&1
:: 2. Restore Application Compatibility Shim Engine (apphelp.dll, PcaSvc & Environment __COMPAT_LAYER)
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "DisableEngine" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "DisablePCA" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "DisableInventory" /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "DisableUAR" /f >nul 2>&1
reg delete "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Environment" /v "__COMPAT_LAYER" /f >nul 2>&1
reg delete "HKCU\Environment" /v "__COMPAT_LAYER" /f >nul 2>&1
reg delete "HKCU\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers" /v "exefile.exe" /f >nul 2>&1
:: 3. Ensure UAC Token Filtering, Microsoft Account Sign-In & Session Manager Heap/Protection are intact
reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v "EnableLUA" /t REG_DWORD /d 1 /f >nul 2>&1
reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" /v "NoConnectedUser" /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager" /v "ProtectionMode" /t REG_DWORD /d 1 /f >nul 2>&1
reg delete "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager" /v "HeapDeCommitFreeBlockThreshold" /f >nul 2>&1
:: 4. Set ConsentUxUserSvc, NcbService, VaultSvc, PcaSvc & Core Installer Services to Manual (Demand-start) / Auto
reg add "HKLM\SYSTEM\CurrentControlSet\Services\ConsentUxUserSvc" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\NcbService" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\VaultSvc" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\PcaSvc" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\Appinfo" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\AppIDSvc" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\iphlpsvc" /v "Start" /t REG_DWORD /d 2 /f >nul 2>&1
:: 5. Ensure all .NET Framework CLR, NGEN & WPF FontCache Services are healthy and enabled
reg add "HKLM\SYSTEM\CurrentControlSet\Services\FontCache" /v "Start" /t REG_DWORD /d 2 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\FontCache3.0.0.0" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Services\NetTcpPortSharing" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
for %%N in (clr_optimization_v4.0.30319_64 clr_optimization_v4.0.30319_32 clr_optimization_v2.0.50727_64 clr_optimization_v2.0.50727_32) do (
    reg query "HKLM\SYSTEM\CurrentControlSet\Services\%%N" >nul 2>&1 && reg add "HKLM\SYSTEM\CurrentControlSet\Services\%%N" /v "Start" /t REG_DWORD /d 3 /f >nul 2>&1
)
schtasks /Change /TN "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319" /Enable >nul 2>&1
schtasks /Change /TN "\Microsoft\Windows\.NET Framework\.NET Framework NGEN v4.0.30319 64" /Enable >nul 2>&1

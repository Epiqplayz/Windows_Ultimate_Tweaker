:: ==============================================================================
:: MODULE [95]: ADVANCED KERNEL MEMORY MANAGER (MM), PAGE TABLE & WORKING SET SUITE
:: ==============================================================================
:deep_memory_compression_working_set_matrix
cls
echo.
echo   %b%+==============================================================================================================+%w%
echo   %b%^|%w%          %p%SMOOTH PRIME v7x  -  KERNEL MEMORY MANAGER (MM), PAGE TABLE ^& MMAgent CONTROLLER%w%                   %b%^|%w%
echo   %b%^|%w%            %g%ENGINEERED BY SMOOTH PRIME  ^|  Tailored Profiles for 4GB-8GB vs 16GB-64GB+ Gaming PCs%w%           %b%^|%w%
echo   %b%+==============================================================================================================+%w%
echo.
echo   %b%+--- %p%SELECT PHYSICAL RAM CAPACITY PROFILE%b% ------------------------------------------------------------------+%w%
echo   %b%^|%w%  %p%[%w%1%p%]%w%  4GB - 8GB Low-End RAM Survival Profile [Keep MemoryCompression On + Aggressive Working Set Trim]        %b%^|%w%
echo   %b%^|%w%  %p%[%w%2%p%]%w%  16GB - 64GB+ High-FPS Gaming Profile [Disable MemoryCompression CPU Tax + Lock Kernel in Physical RAM] %b%^|%w%
echo   %b%^|%w%  %p%[%w%3%p%]%w%  Restore Windows Default Memory Management ^& MMAgent Settings                                            %b%^|%w%
echo   %b%+--------------------------------------------------------------------------------------------------------------+%w%
echo    %p%[%w%M%p%]%w% Back to Smooth Prime v7x Main Dashboard
echo.
set "mm_prof="
set /p "mm_prof=  %p%[SmoothPrime v7x]%w% Select Option: "
if /i "%mm_prof%"=="1" goto mm_lowend_4_8
if /i "%mm_prof%"=="2" goto mm_gaming_16_64
if /i "%mm_prof%"=="3" goto mm_restore_def
if /i "%mm_prof%"=="M" goto menu
goto deep_memory_compression_working_set_matrix

:mm_lowend_4_8
echo.
echo   %w%[*] Applying 4GB - 8GB Low-End RAM Profile [Zero PageCombining Stutter + Fast Standby Purge]...%b%
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v "EnableSuperfetch" /t REG_DWORD /d "0" /f >nul 2>&1
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Enable-MMAgent -MemoryCompression -ErrorAction SilentlyContinue; Disable-MMAgent -PageCombining -ApplicationPreLaunch -ErrorAction SilentlyContinue" >nul 2>&1
call :RunEngine PurgeMemory
echo   %p%[+] 4GB-8GB Low-End RAM Survival Profile Applied ^& Working Sets Purged!%w%
call :SmoothPrimePause
goto deep_memory_compression_working_set_matrix

:mm_gaming_16_64
echo.
echo   %w%[*] Applying 16GB - 64GB+ Gaming RAM Profile [DisablePagingExecutive=1 + Zero MemoryCompression CPU Tax]...%b%
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Disable-MMAgent -MemoryCompression -PageCombining -ApplicationPreLaunch -MaxOperationAPIFiles 256 -ErrorAction SilentlyContinue" >nul 2>&1
call :RunEngine PurgeMemory
echo   %p%[+] 16GB-64GB+ High-FPS Gaming RAM Profile Applied [Zero Compression CPU Overhead]!%w%
call :SmoothPrimePause
goto deep_memory_compression_working_set_matrix

:mm_restore_def
echo.
echo   %w%[*] Restoring Default Windows Memory Management ^& MMAgent Settings...%b%
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "DisablePagingExecutive" /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management" /v "LargeSystemCache" /t REG_DWORD /d 0 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v "EnablePrefetcher" /t REG_DWORD /d 3 /f >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management\PrefetchParameters" /v "EnableSuperfetch" /t REG_DWORD /d 3 /f >nul 2>&1
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Enable-MMAgent -MemoryCompression -PageCombining -ApplicationPreLaunch -ErrorAction SilentlyContinue" >nul 2>&1
echo   %p%[+] Default Windows Memory Management Settings Restored.%w%
call :SmoothPrimePause
goto deep_memory_compression_working_set_matrix


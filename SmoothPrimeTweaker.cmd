echo.
echo   %b%^|%w%  %p%[%w%1%p%]%w% Fix Windows 10/11 Duplicate GameInputSvc Conflict (Stops Random Mouse/Controller Freezes!)
echo.
echo   %b%^|%w%  %p%[%w%2%p%]%w% Optimize Unreal Engine 4/5 ^& Shader Compiler Worker Priority (Stops 100%% CPU Freeze)
echo.
echo   %b%^|%w%  %p%[%w%3%p%]%w% Purge Game Crash Dumps (Fortnite, Valorant, CS2, Roblox, Apex, Windows CrashDumps)
echo.
echo   %b%^|%w%  %p%[%w%M%p%]%w% Back to Main Menu
echo.
set "eng_opt="
set "eng_opt="
set /p "eng_opt=  %p%[SmoothPrime v7x]%w% Select Option: "
if /i "%eng_opt%"=="1" goto eng_1
if /i "%eng_opt%"=="2" goto eng_2
if /i "%eng_opt%"=="3" goto eng_3
if /i "%eng_opt%"=="M" goto menu
echo %w%- Invalid Input %b% & timeout /t 2 >nul & goto engine_config_suite

:eng_1
cls
echo.
echo %w%- Auditing ^& Fixing Duplicate Microsoft GameInput Service (GameInputSvc) Freeze Bug...%b%
:: When both C:\Program Files (x86)\Microsoft GameInput and C:\Windows\System32\GameInputSvc.dll exist,
:: Windows spawns conflicting GameInput hosts that freeze mice/controllers mid-game!
if exist "%ProgramFiles(x86)%\Microsoft GameInput" (
    if exist "%SystemRoot%\System32\GameInputSvc.dll" (
        sc stop "GameInput Service" >nul 2>&1
        sc config "GameInput Service" start= disabled >nul 2>&1
    )
)
reg add "HKLM\SYSTEM\CurrentControlSet\Services\GameInputSvc" /v "Start" /t REG_DWORD /d "3" /f >nul 2>&1
echo %p%[OK] GameInputSvc Conflict Resolved!%w%
call :SmoothPrimePause
goto engine_config_suite

:eng_2
cls
echo.
echo %w%- Setting Shader Compile Workers (UE4/UE5 ShaderCompileWorker.exe) to Below-Normal Priority...%b%
:: Prevents background shader compilation from starving the main game render thread on 4-core/6-core CPUs!
for %%W in (ShaderCompileWorker.exe UnrealCEFSubProcess.exe CefSharp.BrowserSubprocess.exe CrashReportClient.exe) do (
    reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\%%W\PerfOptions" /v "CpuPriorityClass" /t REG_DWORD /d "5" /f >nul 2>&1
    reg add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\%%W\PerfOptions" /v "IoPriority" /t REG_DWORD /d "1" /f >nul 2>&1
)
call :SmoothPrimePause
goto engine_config_suite

:eng_3
cls
echo.
echo %w%- Purging Stale Game Crash Dumps ^& Telemetry Logs...%b%
del /f /s /q "%LocalAppData%\CrashDumps\*.*" >nul 2>&1
del /f /s /q "%LocalAppData%\FortniteGame\Saved\Crashes\*.*" >nul 2>&1
del /f /s /q "%LocalAppData%\FortniteGame\Saved\Logs\*.*" >nul 2>&1
del /f /s /q "%LocalAppData%\VALORANT\Saved\Crashes\*.*" >nul 2>&1
del /f /s /q "%LocalAppData%\VALORANT\Saved\Logs\*.*" >nul 2>&1
del /f /s /q "%LocalAppData%\Roblox\logs\*.*" >nul 2>&1
echo %p%[OK] All Stale Game Crash Dumps Purged!%w%
call :SmoothPrimePause
goto engine_config_suite


echo   %b%^|%w%  %p%[%w%3%p%]%w% Set Quad9 Unfiltered Low-Latency DNS (9.9.9.10 / 149.112.112.10)
echo.
echo   %b%^|%w%  %p%[%w%4%p%]%w% Set OpenDNS High-Speed DNS (208.67.222.222 / 208.67.220.220)
echo.
echo   %b%^|%w%  %p%[%w%5%p%]%w% Benchmark All DNS Providers ^& Auto-Apply Lowest Ping DNS!
echo.
echo   %b%^|%w%  %p%[%w%6%p%]%w% Optimize NIC Hardware Rx/Tx Buffers (1024), RSS Queues ^& Interrupt Moderation
echo.
echo   %b%^|%w%  %p%[%w%R%p%]%w% Reset DNS to Automatic (DHCP Default)        %p%[%w%M%p%]%w% Back to Main Menu
echo.
set "dns_opt="
set "dns_opt="
set /p "dns_opt=  %p%[SmoothPrime v7x]%w% Select Option: "
if /i "%dns_opt%"=="1" call :apply_dns_pair 1.1.1.1 1.0.0.1 "Cloudflare Gaming DNS" & pause >nul & goto nic_dns_advanced_suite
if /i "%dns_opt%"=="2" call :apply_dns_pair 8.8.8.8 8.8.4.4 "Google Public DNS" & pause >nul & goto nic_dns_advanced_suite
if /i "%dns_opt%"=="3" call :apply_dns_pair 9.9.9.10 149.112.112.10 "Quad9 Low-Latency DNS" & pause >nul & goto nic_dns_advanced_suite
if /i "%dns_opt%"=="4" call :apply_dns_pair 208.67.222.222 208.67.220.220 "OpenDNS Home" & pause >nul & goto nic_dns_advanced_suite
if /i "%dns_opt%"=="5" goto dns_benchmark
if /i "%dns_opt%"=="6" goto nic_hw_buffers
if /i "%dns_opt%"=="R" goto dns_reset_dhcp
if /i "%dns_opt%"=="M" goto menu
echo %w%- Invalid Input %b% & timeout /t 2 >nul & goto nic_dns_advanced_suite

:apply_dns_pair
echo.
echo %w%- Applying %~3 (%1 / %2) to All Active Network Adapters...%b%
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "Get-NetAdapter | Where-Object { $_.Status -eq 'Up' } | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ServerAddresses ('%1','%2') -ErrorAction SilentlyContinue }" >nul 2>&1
ipconfig /flushdns >nul 2>&1
echo %p%[OK] %~3 (%1 / %2) Applied ^& DNS Cache Flushed!%w%
exit /b 0

:dns_benchmark
cls
echo.
echo %w%- Benchmarking Latency to Cloudflare (1.1.1.1), Google (8.8.8.8), Quad9 (9.9.9.10) ^& OpenDNS (208.67.222.222)...%b%
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "$providers = @(@{Name='Cloudflare';P='1.1.1.1';S='1.0.0.1'},@{Name='Google';P='8.8.8.8';S='8.8.4.4'},@{Name='Quad9';P='9.9.9.10';S='149.112.112.10'},@{Name='OpenDNS';P='208.67.222.222';S='208.67.220.220'});" ^
    "$best = $null; $bestMs = 9999;" ^
    "foreach ($pr in $providers) { $ping = Test-Connection -ComputerName $pr.P -Count 2 -ErrorAction SilentlyContinue | Measure-Object -Property ResponseTime -Average; $avg = if ($ping.Average) { [math]::Round($ping.Average, 1) } else { 9999 }; Write-Host ('  [DNS] ' + $pr.Name.PadRight(12) + ' (' + $pr.P + ') : ' + $avg + ' ms') -ForegroundColor Cyan; if ($avg -lt $bestMs) { $bestMs = $avg; $best = $pr } };" ^
    "if ($best -and $bestMs -lt 9999) { Write-Host \"`n  [+] Winner: $($best.Name) ($($best.P)) at $bestMs ms! Applying to active adapters...\" -ForegroundColor Green; Get-NetAdapter | Where-Object { $_.Status -eq 'Up' } | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ServerAddresses @($best.P, $best.S) -EA 0 } }"
ipconfig /flushdns >nul 2>&1
echo.
call :SmoothPrimePause
goto nic_dns_advanced_suite

:nic_hw_buffers
cls
echo.
echo %w%- Optimizing NIC Hardware Rx/Tx Ring Buffers, RSS Queues ^& Flow Control...%b%
for /f "tokens=*" %%n in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4D36E972-E325-11CE-BFC1-08002bE10318}" /v "*SpeedDuplex" /s 2^>nul ^| findstr "HKEY"') do (
    reg add "%%n" /v "*ReceiveBuffers" /t REG_SZ /d "1024" /f >nul 2>&1
    reg add "%%n" /v "*TransmitBuffers" /t REG_SZ /d "1024" /f >nul 2>&1
    reg add "%%n" /v "*RSS" /t REG_SZ /d "1" /f >nul 2>&1
    reg add "%%n" /v "*NumRssQueues" /t REG_SZ /d "4" /f >nul 2>&1
    reg add "%%n" /v "*FlowControl" /t REG_SZ /d "0" /f >nul 2>&1
    reg add "%%n" /v "*InterruptModeration" /t REG_SZ /d "0" /f >nul 2>&1
    reg add "%%n" /v "RxIntDelay" /t REG_SZ /d "0" /f >nul 2>&1
    reg add "%%n" /v "TxIntDelay" /t REG_SZ /d "0" /f >nul 2>&1
)
call :SmoothPrimePause
goto nic_dns_advanced_suite

:dns_reset_dhcp
cls
echo.
echo %w%- Resetting All Network Adapters to Automatic DHCP DNS...%b%
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "Get-NetAdapter | ForEach-Object { Set-DnsClientServerAddress -InterfaceIndex $_.ifIndex -ResetServerAddresses -ErrorAction SilentlyContinue }" >nul 2>&1
ipconfig /flushdns >nul 2>&1
call :SmoothPrimePause
goto nic_dns_advanced_suite


:: ==============================================================================
:: AUTOMATED OS, BUILD, UBR, UPDATE BRANCH & WDDM KERNEL DETECTION ENGINE
:: Supports Windows 10 (20H1/19041 -> 22H2/19045) through Windows 11 (21H2/22000 -> 26H2/27xxx+)
:: ==============================================================================
:DetectOSBuild
set "WIN_BUILD=19045"
set "WIN_UBR=0"
set "WIN_DISPLAY_VER=22H2"
set "WIN_RELEASE_ID=2009"
set "WIN_EDITION=Professional"
set "WIN_BUILDLAB=19045.vb_release"
set "WIN_VER=10"
set "OS_FAMILY=WIN10"
set "OS_BRANCH_TAG=Win10_21H2-22H2_Vibranium"
set "OS_KERNEL_CODENAME=Vibranium [Win10 21H2-22H2]"
set "WDDM_TARGET=WDDM 2.7"
set "IS_WIN10=1"
set "IS_WIN11=0"
set "IS_WIN10_20H1_21H1=0"
set "IS_WIN10_21H2_22H2=0"
set "IS_WIN11_21H2=0"
set "IS_WIN11_22H2_23H2=0"
set "IS_WIN11_24H2_25H2=0"
set "IS_WIN11_26H2_PLUS=0"
set "IS_WIN11_22H2_PLUS=0"
set "IS_WIN11_24H2_PLUS=0"

set "CV_KEY=HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion"
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v CurrentBuildNumber 2^>nul ^| findstr /i "CurrentBuildNumber"') do set "WIN_BUILD=%%A"
if "%WIN_BUILD%"=="19045" (
    for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v CurrentBuild 2^>nul ^| findstr /i "CurrentBuild"') do set "WIN_BUILD=%%A"
)
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v UBR 2^>nul ^| findstr /i "UBR"') do set /a "WIN_UBR=%%A" 2>nul
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v ReleaseId 2^>nul ^| findstr /i "ReleaseId"') do set "WIN_RELEASE_ID=%%A"
set "WIN_DISPLAY_VER=%WIN_RELEASE_ID%"
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v DisplayVersion 2^>nul ^| findstr /i "DisplayVersion"') do set "WIN_DISPLAY_VER=%%A"
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v EditionID 2^>nul ^| findstr /i "EditionID"') do set "WIN_EDITION=%%A"
for /f "tokens=3" %%A in ('reg query "%CV_KEY%" /v BuildLabEx 2^>nul ^| findstr /i "BuildLabEx"') do set "WIN_BUILDLAB=%%A"

if "%WIN_DISPLAY_VER%"=="2004" set "WIN_DISPLAY_VER=20H1"
if "%WIN_DISPLAY_VER%"=="2009" (
    if "%WIN_BUILD%"=="19042" set "WIN_DISPLAY_VER=20H2"
    if "%WIN_BUILD%"=="19043" set "WIN_DISPLAY_VER=21H1"
    if "%WIN_BUILD%"=="19044" set "WIN_DISPLAY_VER=21H2"
    if "%WIN_BUILD%"=="19045" set "WIN_DISPLAY_VER=22H2"
)

set /a "NUM_BUILD=%WIN_BUILD%" 2>nul
if !NUM_BUILD! LSS 22000 (
    set "WIN_VER=10"
    set "OS_FAMILY=WIN10"
    set "IS_WIN10=1"
    set "IS_WIN11=0"
    set "WDDM_TARGET=WDDM 2.7"
    if !NUM_BUILD! LEQ 19043 (
        set "IS_WIN10_20H1_21H1=1"
        set "OS_BRANCH_TAG=Win10_20H1-21H1_Vibranium"
        set "OS_KERNEL_CODENAME=Vibranium [Win10 20H1-21H1]"
    ) else (
        set "IS_WIN10_21H2_22H2=1"
        set "OS_BRANCH_TAG=Win10_21H2-22H2_Vibranium"
        set "OS_KERNEL_CODENAME=Vibranium [Win10 21H2-22H2]"
    )
) else (
    set "WIN_VER=11"
    set "OS_FAMILY=WIN11"
    set "IS_WIN10=0"
    set "IS_WIN11=1"
    if !NUM_BUILD! LSS 22621 (
        set "IS_WIN11_21H2=1"
        set "OS_BRANCH_TAG=Win11_21H2_Cobalt"
        set "OS_KERNEL_CODENAME=Cobalt [Win11 21H2]"
        set "WDDM_TARGET=WDDM 3.0"
    ) else if !NUM_BUILD! LSS 26000 (
        set "IS_WIN11_22H2_23H2=1"
        set "IS_WIN11_22H2_PLUS=1"
        set "OS_BRANCH_TAG=Win11_22H2-23H2_Nickel"
        set "OS_KERNEL_CODENAME=Nickel [Win11 22H2/23H2]"
        set "WDDM_TARGET=WDDM 3.1"
    ) else if !NUM_BUILD! LSS 27000 (
        set "IS_WIN11_24H2_25H2=1"
        set "IS_WIN11_22H2_PLUS=1"
        set "IS_WIN11_24H2_PLUS=1"
        set "OS_BRANCH_TAG=Win11_24H2-25H2_Germanium"
        set "OS_KERNEL_CODENAME=Germanium [Win11 24H2/25H2]"
        set "WDDM_TARGET=WDDM 3.2"
        if /i "!WIN_DISPLAY_VER!"=="26H2" (
            set "IS_WIN11_26H2_PLUS=1"
            set "OS_BRANCH_TAG=Win11_26H2_Bromine"
            set "OS_KERNEL_CODENAME=Bromine [Win11 26H2]"
            set "WDDM_TARGET=WDDM 3.2+"
        )
    ) else (
        set "IS_WIN11_26H2_PLUS=1"
        set "IS_WIN11_22H2_PLUS=1"
        set "IS_WIN11_24H2_PLUS=1"
        set "OS_BRANCH_TAG=Win11_26H2_Bromine"
        set "OS_KERNEL_CODENAME=Bromine [Win11 26H2+]"
        set "WDDM_TARGET=WDDM 3.2+"
    )
)
if not defined TOTAL_RAM_MB (
    set "TOTAL_RAM_MB=16384"
    set "TOTAL_RAM_GB=16"
    for /f "tokens=1" %%M in ('powershell -NoProfile -Command "[math]::Round((Get-CimInstance Win32_ComputerSystem -EA 0).TotalPhysicalMemory / 1MB)" 2^>nul') do set "TOTAL_RAM_MB=%%M"
    set /a "TOTAL_RAM_GB=(!TOTAL_RAM_MB! + 512) / 1024" 2>nul
)
set "OS_FULL_BANNER=Windows !WIN_VER! !WIN_DISPLAY_VER! [!WIN_EDITION! - Build !WIN_BUILD!.!WIN_UBR! - !OS_BRANCH_TAG! - !WDDM_TARGET!]"
exit /b 0

:: ==============================================================================
:: MULTI-LAYER GPU & CPU P/E CORE TELEMETRY ENGINE (RTX 2050 / OPTIMUS / DESKTOP SAFE)
:: ==============================================================================
:DetectGPUs
call :DetectOSBuild
call :InitPInvokeEngine
set "HAS_NVIDIA=0"
set "HAS_AMD=0"
set "HAS_INTEL=0"
set "GPU_MODEL_NVIDIA="
set "GPU_MODEL_AMD="
set "GPU_MODEL_INTEL="
set "DETECTED_GPU_NAME=Generic Display Adapter"
set "GPU_TYPE=GENERIC"
set "IS_HYBRID_GPU=0"

:: Detect CPU P-Cores, E-Cores & Threads via Native GetLogicalProcessorInformationEx P/Invoke Engine
set "CPU_CORES=%NUMBER_OF_PROCESSORS%"
set "CPU_PCORES=%NUMBER_OF_PROCESSORS%"
set "CPU_ECORES=0"
set "CPU_THREADS=%NUMBER_OF_PROCESSORS%"
set "CPU_CLEAN_NAME=%CPU_BRAND% Processor"

for /f "tokens=1,2 delims==" %%A in ('powershell -NoProfile -ExecutionPolicy Bypass -File "C:\Smooth\Engine\SmoothPrimeEngine.ps1" -Action Telemetry 2^>nul') do (
    set "%%A=%%B"
)
set "CPU_TOPOLOGY_STR=!CPU_CORES! Cores [!CPU_PCORES!P + !CPU_ECORES!E] / !CPU_THREADS! Threads"

:: LAYER 1: Direct Registry Display Class Scan ({4d36e968-e325-11ce-bfc1-08002be10318})
for /f "tokens=*" %%K in ('reg query "HKLM\SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}" 2^>nul ^| findstr /r "\\[0-9][0-9][0-9][0-9]$"') do (
    for /f "tokens=2*" %%A in ('reg query "%%K" /v "DriverDesc" 2^>nul ^| findstr /i "DriverDesc"') do (
        call :CheckGpuString "%%B"
    )
    for /f "tokens=2*" %%A in ('reg query "%%K" /v "MatchingDeviceId" 2^>nul ^| findstr /i "MatchingDeviceId"') do (
        echo "%%B" | findstr /i "VEN_10DE" >nul 2>&1 && set "HAS_NVIDIA=1"
        echo "%%B" | findstr /i "VEN_1002" >nul 2>&1 && set "HAS_AMD=1"
        echo "%%B" | findstr /i "VEN_8086" >nul 2>&1 && set "HAS_INTEL=1"
    )
)

:: LAYER 2: Direct PCI Enum Hardware Vendor ID Scan
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /f "VEN_10DE" /k >nul 2>&1 && set "HAS_NVIDIA=1"
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /f "VEN_1002" /k >nul 2>&1 && set "HAS_AMD=1"
reg query "HKLM\SYSTEM\CurrentControlSet\Enum\PCI" /f "VEN_8086" /k >nul 2>&1 && (
    if "%HAS_NVIDIA%"=="0" if "%HAS_AMD%"=="0" set "HAS_INTEL=1"
)

:: LAYER 3: PowerShell CIM / WMI VideoController Enumeration
for /f "usebackq delims=" %%G in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Get-CimInstance Win32_VideoController -ErrorAction Stop | ForEach-Object { $_.Name } } catch { Get-WmiObject Win32_VideoController -ErrorAction SilentlyContinue | ForEach-Object { $_.Name } }" 2^>nul`) do (
    call :CheckGpuString "%%G"
)

:: DEDICATED GPU PRIORITY RESOLUTION (Bracket-formatted so no parentheses ever trip cmd.exe!)
if "%HAS_INTEL%"=="1" (
    set "GPU_TYPE=INTEL"
    if defined GPU_MODEL_INTEL (set "DETECTED_GPU_NAME=!GPU_MODEL_INTEL!") else (set "DETECTED_GPU_NAME=Intel Integrated Graphics")
)
if "%HAS_AMD%"=="1" (
    set "GPU_TYPE=AMD"
    if defined GPU_MODEL_AMD (set "DETECTED_GPU_NAME=!GPU_MODEL_AMD!") else (set "DETECTED_GPU_NAME=AMD Radeon Graphics")
)
if "%HAS_NVIDIA%"=="1" (
    set "GPU_TYPE=NVIDIA"
    if defined GPU_MODEL_NVIDIA (set "DETECTED_GPU_NAME=!GPU_MODEL_NVIDIA!") else (set "DETECTED_GPU_NAME=NVIDIA GeForce GPU")
    if "%HAS_INTEL%"=="1" (
        set "IS_HYBRID_GPU=1"
        set "DETECTED_GPU_NAME=!DETECTED_GPU_NAME! + Intel iGPU [Optimus]"
    ) else if "%HAS_AMD%"=="1" (
        set "IS_HYBRID_GPU=1"
        set "DETECTED_GPU_NAME=!DETECTED_GPU_NAME! + AMD iGPU [Hybrid]"
    )
)
exit /b 0

:CheckGpuString
set "RAW_GPU=%~1"
if not defined RAW_GPU exit /b 0
set "CLEAN_GPU=!RAW_GPU:(R)=!"
set "CLEAN_GPU=!CLEAN_GPU:(TM)=!"
set "CLEAN_GPU=!CLEAN_GPU:(=[!"
set "CLEAN_GPU=!CLEAN_GPU:)=]!"
echo "!CLEAN_GPU!" | findstr /i "NVIDIA GeForce RTX Quadro GTX Tesla" >nul 2>&1
if !errorlevel! equ 0 (
    set "HAS_NVIDIA=1"
    if not defined GPU_MODEL_NVIDIA set "GPU_MODEL_NVIDIA=!CLEAN_GPU!"
)
echo "!CLEAN_GPU!" | findstr /i "AMD Radeon RX Vega FirePro" >nul 2>&1
if !errorlevel! equ 0 (
    set "HAS_AMD=1"
    if not defined GPU_MODEL_AMD set "GPU_MODEL_AMD=!CLEAN_GPU!"
)
echo "!CLEAN_GPU!" | findstr /i "Intel Arc Iris UHD HD" >nul 2>&1
if !errorlevel! equ 0 (
    set "HAS_INTEL=1"
    if not defined GPU_MODEL_INTEL set "GPU_MODEL_INTEL=!CLEAN_GPU!"
)
exit /b 0

